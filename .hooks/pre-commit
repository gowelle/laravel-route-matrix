#!/bin/sh

# Pre-commit hook for Laravel Pint code formatting

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.php$')

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "Running Laravel Pint on staged PHP files..."

# Run Pint on staged files
./vendor/bin/pint $STAGED_FILES

# Re-add the fixed files to staging
echo "$STAGED_FILES" | xargs git add

echo "Code formatting complete!"
exit 0
